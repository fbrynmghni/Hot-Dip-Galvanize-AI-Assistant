{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/hooks/review-gate.sh\"",
            "timeout": 15,
            "statusMessage": "Cek gate review..."
          }
        ]
      }
    ]
  }
}
