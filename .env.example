# =============================================================================
# GalvaAI — contoh konfigurasi environment
# =============================================================================
# File INI ikut ter-commit (tanpa nilai asli).
# Salin jadi .env lalu isi nilainya:   cp .env.example .env
#
# JANGAN pernah commit file .env. Sudah ditutup .gitignore — biarkan begitu.
# =============================================================================

# --- OpenAI (LLM utama) ------------------------------------------------------
# Ambil di https://platform.openai.com/api-keys
# Kunci diawali "sk-..." dan hanya ditampilkan SEKALI saat dibuat.
OPENAI_API_KEY=

# Model untuk chat + tool calling.
# Terverifikasi 2026-09-15: gpt-5.5 tersedia & tool calling jalan.
# Alias "gpt-5.5" saat ini me-resolve ke snapshot gpt-5.5-2026-04-23.
#
# PERTIMBANGKAN PIN KE SNAPSHOT untuk produksi:
#   OPENAI_MODEL=gpt-5.5-2026-04-23
# Alias bisa bergeser ke versi baru tanpa perubahan kode, dan itu menggeser
# skor golden set tanpa jejak di git — masalah nyata karena target numeric
# correctness kita 100%.
#
# CATATAN API: gpt-5.x adalah reasoning model.
#  - pakai `max_completion_tokens`, BUKAN `max_tokens`
#  - reasoning token ditagih sebagai completion token
#  - budget terlalu kecil -> reasoning menghabiskan jatah, content balik kosong
#    dengan finish_reason "length"
# Cek daftar model di akun: ./scripts/cek-model.sh
OPENAI_MODEL=gpt-5.5

# Model embedding untuk RAG. Dimensi vektor harus cocok dengan kolom
# vector(n) di skema Postgres — lihat .claude/skills/hdg-rag-ingest/references/schema.sql
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=1024

# Opsional: organization / project id bila akun punya lebih dari satu
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# --- Supabase (vector store + DB) — Fase 2 -----------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server-only, JANGAN pakai prefix NEXT_PUBLIC_

# --- Rate limiting (Upstash) — Fase 2 ----------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Crawler ------------------------------------------------------------------
# Kontak yang dicantumkan di User-Agent saat crawl AGA/GAA.
# Asosiasi berhak tahu siapa yang mengambil kontennya.
# CRAWLER_CONTACT_EMAIL=

# --- Umum ---------------------------------------------------------------------
NODE_ENV=development
